{
  "name": "notification-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env src/entrypoints/api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/entrypoints/worker.ts",
    "dev:dispatcher": "tsx watch --env-file-if-exists=.env src/entrypoints/dispatcher.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:contract": "vitest run --project contract",
    "test:e2e": "vitest run --project e2e",
    "db:migrate": "tsx --env-file-if-exists=.env src/entrypoints/migrate.ts",
    "config:apply": "tsx --env-file-if-exists=.env src/entrypoints/config-apply.ts",
    "test:infra": "vitest run --project integration tests/integration/infra",
    "smoke:local": "scripts/smoke-local.sh"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@fastify/type-provider-typebox": "6.3.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "bullmq": "6.3.16",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "nodemailer": "10.1.2",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "typebox": "1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "smtp-server": "3.19.23",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
