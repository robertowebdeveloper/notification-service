# Copy to .env for running the app on the host (npm run dev:*) against the local Compose infra.
# Placeholders only: never commit real credentials.
# Required (no default): local | test | stage | production. stage/production enable the TLS
# checks (DATABASE_SSL, rediss://) and refuse provider instances with profile "local".
APP_ENV=local
LOG_LEVEL=debug
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
# Internal ops server: /metrics and worker/dispatcher health. Do not expose via ingress.
OPS_HOST=0.0.0.0
OPS_PORT=9100
DATABASE_URL=postgres://notifications:notifications@localhost:5432/notifications
DATABASE_SSL=false
DATABASE_POOL_MAX=10
VALKEY_URL=redis://localhost:6379
OUTBOX_BACKLOG_LIMIT=10000
# In stage/production it must exceed WORKER_SEND_TIMEOUT_MS + 2 x LIMITS_BACKEND_TIMEOUT_MS.
SHUTDOWN_GRACE_MS=40000
# Allowed destinations of operator-configured provider endpoints (SMTP host, Resend baseUrl):
# exact hostnames or .suffix (subdomains only). Unset = unrestricted (warning in stage/production).
# PROVIDER_ALLOWED_HOSTS=smtp.example.com,.resend.com

# Operational tuning (optional; the values shown are the defaults). Validated at startup:
# invalid values or inconsistent combinations make the process exit with code 1.
# PostgreSQL timeouts: connect/acquire, server statement_timeout, client read deadline (must
# exceed the statement timeout), idle-in-transaction, idle pool clients, TCP keepalive delay.
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_STATEMENT_TIMEOUT_MS=15000
# DATABASE_QUERY_TIMEOUT_MS=20000
# DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# DATABASE_POOL_IDLE_TIMEOUT_MS=30000
# DATABASE_KEEPALIVE_INITIAL_DELAY_MS=10000
# API server: time to receive a request, time to process it (then 503), proxy trust for the
# client IP (true | false | hop count | comma-separated proxy IPs/CIDRs; unset = false).
# HTTP_REQUEST_TIMEOUT_MS=30000
# HTTP_HANDLER_TIMEOUT_MS=30000
# HTTP_TRUST_PROXY=
# API ingress (Valkey fixed windows, fail open): per tenant (submissions, manual retries), per
# tenant for reads (GET), per webhook instance for verified calls, per webhook instance for
# calls failing verification, per client IP for failed authentications (API key or webhook;
# once exceeded the IP gets 429 before any database lookup).
# INGRESS_RATE_LIMIT=100
# INGRESS_RATE_WINDOW_MS=1000
# READ_RATE_LIMIT=300
# READ_RATE_WINDOW_MS=1000
# WEBHOOK_RATE_LIMIT=200
# WEBHOOK_RATE_WINDOW_MS=1000
# WEBHOOK_INVALID_RATE_LIMIT=50
# WEBHOOK_INVALID_RATE_WINDOW_MS=60000
# AUTH_FAILURE_RATE_LIMIT=30
# AUTH_FAILURE_RATE_WINDOW_MS=60000
# Worker: delivery lease (renewed every third while sending, min 3000), provider call deadline
# (may exceed the lease), concurrency per process.
# DELIVERY_LEASE_MS=60000
# WORKER_SEND_TIMEOUT_MS=30000
# WORKER_CONCURRENCY=10
# Deadline of one call to the shared limiter/breaker in Valkey (lease must be >= 3x this).
# LIMITS_BACKEND_TIMEOUT_MS=2000
# Default per provider-instance limits; config:apply can override them per instance
# (providerInstances[].sendRateLimit / circuitBreaker).
# PROVIDER_RATE_LIMIT_BURST=20
# PROVIDER_RATE_LIMIT_PER_SECOND=10
# CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# CIRCUIT_BREAKER_FAILURE_WINDOW_MS=30000
# CIRCUIT_BREAKER_OPEN_MS=30000
# Retry backoff after a certain retryable rejection: base doubles up to max, with jitter (0..1).
# RETRY_BACKOFF_BASE_MS=5000
# RETRY_BACKOFF_MAX_MS=300000
# RETRY_JITTER_RATIO=0.5
# Dispatcher: outbox polling, claim batch, burst bound, outbox lease (> publish timeout).
# DISPATCHER_POLL_INTERVAL_MS=1000
# DISPATCHER_BATCH_SIZE=100
# DISPATCHER_MAX_BATCHES_PER_CYCLE=20
# OUTBOX_LEASE_MS=30000
# QUEUE_PUBLISH_TIMEOUT_MS=3000
# Reconciliation (run by the dispatcher): cycle, batch, lost job re-arm age, unknown handling,
# provider events (orphan age must be >= 3x the reconcile interval).
# RECONCILE_INTERVAL_MS=10000
# RECONCILE_BATCH_SIZE=100
# LOST_PUBLICATION_AFTER_MS=300000
# UNKNOWN_CHECK_INTERVAL_MS=60000
# UNKNOWN_REPLAY_DELAY_MS=30000
# PROVIDER_EVENT_ORPHAN_AFTER_MS=3600000
# PROVIDER_EVENT_BATCH_SIZE=200

# Stage/production (external services, set by the deployment environment):
# APP_ENV=production
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>
# DATABASE_SSL=true
# VALKEY_URL=rediss://<user>:<password>@<host>:6379   (rediss:// is mandatory)
# PROVIDER_ALLOWED_HOSTS=<smtp-host>,.resend.com
# NOTIFICATION_SERVICE_IMAGE=<registry>/notification-service:<version>

# Tests (local Compose infra)
TEST_DATABASE_URL=postgres://notifications:notifications@localhost:5432/notifications_test
TEST_VALKEY_URL=redis://localhost:6379/1
